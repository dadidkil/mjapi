# Wispbyte: Node.js 24 LTS, allocated port. Never commit .env.
NODE_ENV=production
PORT=15377
PUBLIC_URL=https://apimjd.wispbyte.app
ALLOWED_HOSTS=78.154.103.12:15377
DATA_DIR=./cloud/data
# Create private .env with separate keys: node cloud/scripts/setup.js (never prints keys).
API_READ_TOKEN=
API_WRITE_TOKEN=
EXECUTOR_TOKEN=
# Static confidential OAuth client for ChatGPT; exact redirect URI from its connection dialog.
OAUTH_CLIENT_ID=majestic-chatgpt
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform/oauth/redirect
OWNER_PASSWORD=
# Optional; only selected guilds/channels are read. No token extraction from the browser.
DISCORD_TOKEN=
DISCORD_AUTH_MODE=vencord
# Separate application credential, never a Discord account token.
DISCORD_BRIDGE_TOKEN=
DISCORD_GUILD_IDS=1317165120128028773,1525821262054817842
DISCORD_CHANNEL_IDS=
DISCORD_GUILD_SERVERS={}
DISCORD_MESSAGE_LIMIT=100
SOURCES_FILE=./cloud/config/sources.json
SOURCE_ALLOWED_HOSTS=docossum.com,forum.majestic-rp.ru
DISCORD_INTERVAL_SECONDS=900
KNOWLEDGE_INTERVAL_SECONDS=900
SYNC_CONCURRENCY=1
SCHEDULER_ENABLED=1
FORUM_MODE=auto
FORUM_WRITES_ENABLED=0
FORUM_CACHE_SECONDS=60
MAX_DB_MB=160
MAX_DOCUMENT_BYTES=1048576
MAX_RESPONSE_BYTES=1048576
HISTORY_VERSIONS=8
HISTORY_DAYS=30
AUDIT_ROWS=1000
BACKUP_COUNT=1
# Local executor only. Cloud process never connects to loopback on the user's computer.
CLOUD_URL=https://apimjd.wispbyte.app
LOCAL_FORUM_URL=http://127.0.0.1:8787
LOCAL_FORUM_TOKEN=
